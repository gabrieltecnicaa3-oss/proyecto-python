# ======================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
#  Copiar este archivo como .env y completar los valores
# ======================================================

# --- Configuración Flask ---
FLASK_SECRET_KEY=cambiar-por-clave-secreta-segura-generada

# --- Motor de base de datos ---
# Opciones: sqlite (local) | mysql (produccion)
DB_ENGINE=sqlite

# --- Ruta SQLite (solo si DB_ENGINE=sqlite) ---
# DB_PATH=database.db

# --- MySQL (solo si DB_ENGINE=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=nombre_base_datos
MYSQL_USER=usuario_mysql
MYSQL_PASSWORD=contrasena_mysql

# --- Google Drive (opcional, para subir PDFs) ---
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}
# GOOGLE_DRIVE_FOLDER_ID=id_carpeta_drive

# --- OAuth de usuario (alternativa a cuenta de servicio) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
